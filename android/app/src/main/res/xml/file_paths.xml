<?xml version="1.0" encoding="utf-8"?>
<!-- Exposes just the backup folder inside the app's internal files dir
     (Context.getFilesDir()) to the FileProvider used for sharing a
     settings export - see MainActivity.kt's "export" method - plus the
     folder a downloaded update APK lands in, which Android's installer has
     to be able to read (see "installApk"). -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="backup" path="backup/" />
    <cache-path name="update" path="update/" />
</paths>
