<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Required so the panel widgets can fetch their data sources. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Only the coarse variant: a weather widget needs the town, not the
         street, and this asks for the less invasive permission. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Reads events from the calendars already synced on the device (a
         Google account added in Android's own settings included). -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <!-- Just to read the current connection type (WiFi/mobile/none) for the
         {{verbindung}} placeholder - not the network's own traffic. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Reads the step counter sensor for the {{schritte}} placeholder. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <!-- Lets {{meistgenutzt}} read today's per-app usage time. Not grantable
         through a normal runtime prompt - the user turns it on for this app
         in the system's own "Usage access" settings screen, which
         requestUsageAccess() in MainActivity.kt opens directly. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"/>
    <!-- Lets the update screen hand a downloaded APK straight to Android's
         installer instead of routing it through a browser download, which
         needs the same permission for the browser and hides the failure when
         it isn't granted. Android asks once, for this app, and
         "installApk" in MainActivity.kt opens that dialog directly. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Cleartext HTTP is off by default since Android 9 - needed here so
         an action element's http:// call actually reaches a local smart
         home device (almost none of them have a certificate). Data sources
         still enforce https on their own, in data_sources_controller.dart,
         regardless of this. -->
    <application
        android:label="hanneslauncher"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Lets a settings backup file be handed to another app (Drive,
             email, Files, ...) through the normal share sheet, see
             MainActivity.kt's "export" method. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required so a launcher app can enumerate all other launchable apps
             on Android 11+ (package visibility), without the QUERY_ALL_PACKAGES
             permission. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <!-- Required to open web apps (saved links) in a browser on
             Android 11+. The same entry is what makes the installed browsers
             visible to installedBrowsers() in MainActivity.kt at all, so a
             web app can be pointed at one of them - a package this app can't
             see would silently be missing from that list. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- Required so tapping the home screen clock can find and open the
             device's clock app on Android 11+ (package visibility) - without
             this, resolveActivity() in MainActivity.kt silently sees no app
             at all and does nothing. -->
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS"/>
        </intent>
        <!-- Same, for tapping the calendar block to open the calendar app. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.APP_CALENDAR"/>
        </intent>
        <!-- So defaultLauncher() in MainActivity.kt can name the launcher the
             home button currently opens. Without it another launcher stays
             invisible and the settings could only say "not this one" without
             saying which. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.HOME"/>
        </intent>
    </queries>
</manifest>
