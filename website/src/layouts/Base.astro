---
import '@fontsource-variable/hanken-grotesk/wght.css';
import '@fontsource-variable/doto/full.css';
import '@fontsource/ubuntu-mono/400.css';
import '../styles/global.css';
import Consent from '../components/Consent.astro';
import { t, paths, type Lang } from '../i18n/strings';
import { REPO_URL, RELEASES_URL } from '../data/releases';
import { THEMES, DESIGN_KEY } from '../data/themes';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  page?: 'home' | 'privacy';
}
const { lang, title, description, page = 'home' } = Astro.props;
const s = t(lang);
const site = Astro.site ?? new URL('https://hanneslauncher.vercel.app');
const here = new URL(paths[lang][page], site).href;
const alt = (l: Lang) => new URL(paths[l][page], site).href;
const pageTitle = title ?? s.meta.title;
const pageDescription = description ?? s.meta.description;
const og = new URL('/img/og.png', site).href;
const other: Lang = lang === 'de' ? 'en' : 'de';
// structured data: lets search engines show the app as a free Android app
const jsonLd = page === 'home' ? {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'hanneslauncher',
  description: pageDescription,
  url: here,
  image: og,
  inLanguage: lang,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Android',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  downloadUrl: RELEASES_URL,
  codeRepositoryURL: REPO_URL,
  author: { '@type': 'Person', name: 'Hannes' },
} : null;
---
<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={here} />
    <link rel="alternate" hreflang="en" href={alt('en')} />
    <link rel="alternate" hreflang="de" href={alt('de')} />
    <link rel="alternate" hreflang="x-default" href={alt('en')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#f4f3f0" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="hanneslauncher" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={here} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    <meta property="og:locale:alternate" content={other === 'de' ? 'de_DE' : 'en_GB'} />
    <meta property="og:image:alt" content={s.meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={og} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline define:vars={{ redirect: lang === 'en' && page === 'home', themes: THEMES, designKey: DESIGN_KEY }}>
      var d = document.documentElement;
      d.classList.replace('no-js', 'js');
      // the visitor's design choice (or the system's dark mode) before the
      // first paint, so a dark page never flashes light; scripts/design.ts
      // takes over once loaded
      try {
        var st = JSON.parse(localStorage.getItem(designKey) || 'null');
        if (!st && matchMedia('(prefers-color-scheme: dark)').matches) st = { theme: 'dark', r: 24, sh: 0.5 };
        if (st) {
          var th = st.theme && themes[st.theme];
          if (th) {
            d.style.setProperty('--paper', th.ground);
            d.style.setProperty('--card', th.card);
            d.style.setProperty('--ink', th.ink);
            d.style.setProperty('--ink-2', th.ink2);
            d.style.setProperty('--line', th.line);
            d.style.setProperty('--accent', th.accent);
            var tc = document.querySelector('meta[name="theme-color"]');
            if (tc) tc.setAttribute('content', th.ground);
          }
          if (st.theme === 'dark') {
            d.style.setProperty('--on-accent', '#1b1a17');
            d.style.setProperty('--depth', '1.7');
            d.classList.add('theme-dark');
          }
          if (st.r && st.r !== 24) d.style.setProperty('--r', st.r + 'px');
          if (st.sh != null && st.sh !== 0.5) d.style.setProperty('--sh', String(st.sh * 2));
        }
      } catch (e) {}
      // decided before the first paint, so pinned chapters never jump
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion');
      // German browsers land on /de/ - unless someone picked a language
      try {
        var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language];
        if (redirect && !localStorage.getItem('hl-lang') && /^de\b/i.test(langs[0] || '')) {
          location.replace('/de/' + location.hash);
        }
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{s.skip}</a>
    <slot />
    <Consent lang={lang} />
    <script>
      import { initTabTitle } from '../scripts/tabtitle';
      initTabTitle();
    </script>
  </body>
</html>
