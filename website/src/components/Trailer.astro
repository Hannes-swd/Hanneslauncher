---
// The page dives into the trailer's night: a circle of night blue opens as
// the chapter arrives, stars like the trailer's opening drift behind, and
// the video waits behind a click - YouTube only loads once someone asks.
import { t, type Lang } from '../i18n/strings';
interface Props { lang: Lang }
const s = t(Astro.props.lang).trailer;
const ID = 'IV-ss1CVJLQ';
---
<section id="trailer" class="trl" data-chapter data-trailer>
  <div class="trl-night" data-night>
    <canvas class="trl-stars" data-stars aria-hidden="true"></canvas>
    <div class="wrap trl-inner">
      <h2 class="display trl-title"><span class="dots">110</span> {s.title.replace(/^110\s*/, '')}</h2>
      <div class="trl-player" data-player data-yt={ID}>
        <img src="/img/trailer-poster.webp" alt="" width="1600" height="900" loading="lazy" />
        <button class="trl-play" type="button" data-play>
          <span class="trl-play-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg></span>
          <span>{s.play}</span>
        </button>
        <p class="trl-consent" data-consent-note>{s.consent}</p>
      </div>
      <a class="trl-yt" href={`https://youtu.be/${ID}`} rel="noopener">{s.open} ↗</a>
    </div>
  </div>
</section>

<script>
  import { allow } from '../scripts/consent';
  const player = document.querySelector<HTMLElement>('[data-player]')!;
  player.querySelector('[data-play]')!.addEventListener('click', () => {
    allow('media');
    const id = player.dataset.yt!;
    const f = document.createElement('iframe');
    f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
    f.title = 'hanneslauncher trailer';
    f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    f.allowFullscreen = true;
    f.referrerPolicy = 'strict-origin-when-cross-origin';
    player.replaceChildren(f);
  });
</script>

<style>
  .trl { padding-block: var(--s6); }
  .trl-night {
    position: relative; overflow: hidden;
    background: radial-gradient(120% 90% at 50% 0%, var(--night-2), var(--night) 62%);
    color: #e8ebff;
    min-height: 100svh;
    display: grid; align-items: center;
    padding-block: var(--s7);
    clip-path: inset(0 round 0);
  }
  .trl-stars { position: absolute; inset: 0; width: 100%; height: 100%; }
  .trl-inner { position: relative; display: grid; gap: var(--s4); justify-items: center; text-align: center; }
  .trl-over { color: #8d96d8; }
  .trl-title { font-size: clamp(var(--t4), 6vw, var(--t7)); color: #fff; }
  .trl-title .dots { color: #8fd3ff; }
  .trl-player {
    position: relative; width: min(100%, 1040px); aspect-ratio: 16 / 9; margin-top: var(--s4);
    border-radius: var(--r-l); overflow: hidden; background: #05060f;
    box-shadow: 0 40px 120px -30px rgb(0 162 232 / 0.35), 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .trl-player img, .trl-player :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .trl-play {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    display: inline-flex; align-items: center; gap: var(--s3);
    padding: var(--s3) var(--s5) var(--s3) var(--s3); border: 0; border-radius: 999px; cursor: pointer;
    background: rgb(255 255 255 / 0.94); color: var(--night); font-weight: 700; font-size: var(--t1);
    transition: transform var(--fast) var(--ease);
  }
  .trl-play:hover { transform: translate(-50%, -50%) scale(1.04); }
  .trl-play-ico { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: linear-gradient(135deg, #3f48cc, #00a2e8); color: #fff; }
  .trl-consent { position: absolute; left: 0; right: 0; bottom: 0; margin: 0; padding: var(--s3) var(--s4); font-size: var(--t-1); color: #c5cbf5; background: linear-gradient(transparent, rgb(5 6 15 / 0.85)); }
  .trl-yt { color: #aab3ff; font-weight: 600; font-size: var(--t-1); }
</style>
